  lines:
  - NPCName: "T\xF4i"
    dialogueText: "Sao gi\u1EDD anh c\xF2n ch\u01B0a \u0111i n\u1EEFa, b\xE3o s\u1EAFp
      \u0111\u1EBFn r\u1ED3i"
    audioClip: {fileID: 0}
  - NPCName: "Ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
    dialogueText: "Anh c\xF3 th\u1EC3 gi\xFAp t\xF4i \u0111\u01B0\u1EE3c kh\xF4ng,
      con tr\xE2u t\xF4i \u0111ang b\u1ECB ho\u1EA3ng s\u1EE3 v\xE0 kh\xF4ng ch\u1ECBu
      \u0111i, anh c\xF3 th\u1EC3 ph\u1EE5 t\xF4i k\xE9o n\xF3 ra kh\u1ECFi chu\u1ED3ng
      \u0111\u01B0\u1EE3c kh\xF4ng"
    audioClip: {fileID: 0}
  - NPCName: "T\xF4i"
    dialogueText: "Ok, \u0111\u01B0\u1EE3c r\u1ED3i"
    audioClip: {fileID: 0}
